#-----------Day-01-------------------

    #--------------Ansible-----------------
     
   ---
       - name  : Install Nginx on Pathnex server
         hosts : all
         become : yes

         tasks : 
             - name : Install nginx
               yum :
                  name : nginx
                  state : present


   #-------------Terraform-----------

   provider "aws" {
           region = "us-east-1"
            }

   resource "aws_instance" "PathnexEC2" {
       ami = "ami-809890"
       instance_type = " c5.xlarge"
       
       tags = {
           Name  = "Pathnex-EC@" 
          }}

  #-------------Kubernetes-------------

  apiVersion : v1
  kind : Pod
  metadata :
     name :  pathnex-pod
  spec :
    containers :
      - name : web
        image : nginx:latest
        ports :
          - containerPort : 80

  #-----------Shell Script-------------

  #!/bin/bash
  echo "Date : $(date)"
  echo "Hostname: $(hostname)"

  #---------Jenkins----------

  pipeline {
     agent any 
        stages {
            stage('Checkout'){
              steps {
                 git branch: 'main', url: ""
              }
              }
         stage('List Files') {
            steps {
               sh 'ls -la'
                }}}}}

