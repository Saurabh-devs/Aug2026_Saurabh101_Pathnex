#--------ansible -----------------

   - name : Install and start Nginx on Pathnex
     hosts : all
     become : yes

     tasks :
        - name  : Install nginx
	  yum :
	      name : nginx
	      state : present

	- name :  Enable nginx
	  serviec :
	      name : nginx
	      state : started
	      enabled  : yes

#---------Terrform------------

   provider "aws" {
      region = "us-south-1"
      }

    resource "aws_instance" "PathnexEC2" {
         ami = "ami-7897897"
	 instance_type = "r5.2xlarge"

	 tags = {
	    Name  = "Pathnex-server"
	    Environment = "Training"
	    Owner = "PathnexStudents"
	    }
	    }

#-------Kubenetes-------

   apiVrsion : apps/v1
   kind : DEployment
   metadata :
      name : pathnex-deployment
   spec :
      replicas : 2
      selector : 
         matchLabels :
	    app : pathnex
      template:
         matchdata:
	   labels :
	     app : pathnex-app
      spec :
         cp=ontainers :
	    - name  : app
	      image : nginx
	      ports :
	         -containerPort : 80


