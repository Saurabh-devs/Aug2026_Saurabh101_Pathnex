
#----Install and enable nginx

  - name : Install and enable nginx on pathnex server 
    hosts : all
    become : yes 

    tasks:
      name : Install Nginx
      yum: 
        name : nginx
	state: present 

      name : Enable nginx
      service:
        name : nginx
	state : start
	enabled : yes





   - name : Install Nginx and Enable on pathnex server
     hosts: all
     become : yes

     tasks:
       - name : Install Nginx
         yum:
	   name: nginx
	   state: present

	 - name : Enable Nginx
	   service:
	     name: nginx
	     state : start
	     enabled: yes


