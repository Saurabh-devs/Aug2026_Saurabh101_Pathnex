#---------Deployment with 2 replicas sets----------

 apiVersion: apps/v1
 kind: Deployment
 metadata:
    name : deployment-app
 spec:
    replicas: 2
    selector:
      matchLabels :
         app : Pathnex-app
    template:
      metadata:
         labels:
	    app : pathnex-app
      spec :
        -containers:
	    name : pathnex-app-container
	    image :  nginx
	    ports:
	      -containerPort : 80



